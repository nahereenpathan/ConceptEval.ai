# -----------------------------------------------------------------------------
# Concept-Aware Code Evaluation SaaS - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or credentials to source control.
# -----------------------------------------------------------------------------

# Application Environment (development | staging | production | test)
APP_ENV=development
APP_SECRET_KEY=change-this-insecure-key-to-a-32-byte-random-secret
DEBUG=true
LOG_LEVEL=INFO
API_V1_STR=/api/v1
PROJECT_NAME="Concept-Aware Code Evaluation Platform"

# Frontend Origin (CORS and cookie domain)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Database Connection (PostgreSQL)
# For local development with Docker Compose:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/concept_eval_dev
# Synchronous DB URL (for Alembic migrations):
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/concept_eval_dev

# Cache and Celery Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Code Execution Runner Isolation Settings
EXECUTION_RUNNER_MODE=subprocess # subprocess | docker | gvisor
EXECUTION_TIMEOUT_SECONDS=5.0
EXECUTION_MEMORY_LIMIT_MB=128
EXECUTION_MAX_OUTPUT_BYTES=65536

# SaaS Billing (Stripe / Razorpay adapter configuration)
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# NLP Intent Extraction Service
NLP_PROVIDER=baseline # baseline | spacy | openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
